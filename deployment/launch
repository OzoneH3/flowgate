#!/usr/bin/python3
import json,os,pathlib,subprocess,time,sys
here=pathlib.Path(__file__).resolve().parent
zones=json.loads(pathlib.Path('/etc/flowgate/zones.json').read_text())
args=[str(here/'flowgate'),'serve','--socket','/run/flowgate-api/daemon.sock','--database','/var/lib/flowgate/rules.db','--uid','1000','--administrator','--allow-evaluation','--evaluation-state','/run/flowgate-enforcement','--allow-protection','--protection-state','/var/lib/flowgate/protection.json','--allow-traffic-control','--udp-helper',str(here/'udp-collector'),'--restore-udp','--tcp-initiation-helper',str(here/'tcp-initiation'),'--tcp-initiation-cgroup','/sys/fs/cgroup','--tcp-initiation-observe-shared','--systemd-notify']
# bpftune is Type=simple: After= alone does not mean callbacks are installed.
# Wait for its observed program inventory to settle before optional shared attach.
# Timeout disables only event collection; firewall readiness remains independent.
last=None;stable=0;source_ready=False
for _ in range(10):
 try:
  items=json.loads(subprocess.check_output(['/usr/sbin/bpftool'if pathlib.Path('/usr/sbin/bpftool').exists()else'/usr/bin/bpftool','-j','cgroup','show','/sys/fs/cgroup','effective'],timeout=1))
  ids=tuple(sorted((p['id'],p.get('attach_type',''))for p in items))
  has_tuner=any(p.get('name','').startswith('bpftune_conn')and p.get('attach_type')=='cgroup_sock_ops'for p in items)
  stable=stable+1 if ids==last else 0;last=ids
  if has_tuner and stable>=2:source_ready=True;break
 except Exception:stable=0
 time.sleep(1)
if not source_ready:
 print('WARNING: bpftune attachment inventory not settled; optional initiation source disabled for this start, monitoring/enforcement independent',file=sys.stderr)
 for flag in ['--tcp-initiation-helper','--tcp-initiation-cgroup']:
  n=args.index(flag);del args[n:n+2]
 args.remove('--tcp-initiation-observe-shared')
for kind,flag in [('local','--zone-local'),('internet','--zone-internet')]:
 for prefix in zones[kind]:args.extend([flag,prefix])
os.execve(args[0],args,{'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','LANG':'C.UTF-8','NOTIFY_SOCKET':os.environ.get('NOTIFY_SOCKET','')})
