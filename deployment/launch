#!/usr/bin/python3
import json,os,pathlib,subprocess,time,sys
here=pathlib.Path(__file__).resolve().parent
zones=json.loads(pathlib.Path('/etc/flowgate/zones.json').read_text())
admin_config=pathlib.Path('/etc/flowgate/administrator.json')
admin_uid=1000  # Compatibility with old monitoring/receiver installers.
if admin_config.exists() or admin_config.is_symlink():
 if admin_config.is_symlink():raise SystemExit('Unsafe administrator configuration')
 st=admin_config.stat()
 if st.st_uid!=0 or st.st_mode&0o022:raise SystemExit('Unsafe administrator configuration')
 admin_uid=json.loads(admin_config.read_text()).get('uid')
 if type(admin_uid)is not int or not 0<admin_uid<2**32-1:raise SystemExit('Invalid administrator UID')
args=[str(here/'flowgate'),'serve','--socket','/run/flowgate-api/daemon.sock','--database','/var/lib/flowgate/rules.db','--uid',str(admin_uid),'--administrator','--allow-evaluation','--evaluation-state','/run/flowgate-enforcement','--allow-protection','--protection-state','/var/lib/flowgate/protection.json','--allow-traffic-control','--udp-helper',str(here/'udp-collector'),'--restore-udp','--tcp-initiation-helper',str(here/'tcp-initiation'),'--tcp-initiation-cgroup','/sys/fs/cgroup','--tcp-initiation-observe-shared','--systemd-notify']
# bpftune is Type=simple: After= alone does not mean callbacks are installed.
# Wait for its observed program inventory to settle before optional shared attach.
# Timeout disables only event collection; firewall readiness remains independent.
last=None;stable=0;source_ready=False
for _ in range(10):
 try:
  items=json.loads(subprocess.check_output(['/usr/sbin/bpftool'if pathlib.Path('/usr/sbin/bpftool').exists()else'/usr/bin/bpftool','-j','cgroup','show','/sys/fs/cgroup','effective'],timeout=1))
  ids=tuple(sorted((p['id'],p.get('attach_type',''))for p in items))
  has_tuner=any(p.get('name','').startswith('bpftune_conn')and p.get('attach_type')=='cgroup_sock_ops'for p in items)
  stable=stable+1 if ids==last else 0;last=ids
  if has_tuner and stable>=2:source_ready=True;break
 except Exception:stable=0
 time.sleep(1)
if not source_ready:
 print('WARNING: bpftune attachment inventory not settled; optional initiation source disabled for this start, monitoring/enforcement independent',file=sys.stderr)
 for flag in ['--tcp-initiation-helper','--tcp-initiation-cgroup']:
  n=args.index(flag);del args[n:n+2]
 args.remove('--tcp-initiation-observe-shared')

# Discover only hash-pinned brokers for the API UID. Optional root-owned config
# restricts observation to explicit runtimes/prefixes. This never creates a rule;
# helpers join an existing broker as its desktop UID, never as root.
args.extend(['--wine-helper',str(here/'wine-owner-observer.exe')])
args.extend(['--holder-iterator-helper',str(here/'holder-iterator')])
wine_config=pathlib.Path('/etc/flowgate/wine.json')
if wine_config.exists():
 st=wine_config.stat()
 if st.st_uid!=0 or st.st_mode&0o022:raise SystemExit('Wine observer configuration must be root-owned and non-writable')
 if st.st_size>65536:raise SystemExit('Wine observer configuration exceeds limit')
 wc=json.loads(wine_config.read_text())
 if wc == {'schema': 1, 'mode': 'discover'}:
  pass # No path restrictions: supported-build discovery for the configured UID.
 else:
  if wc.get('schema')!=1 or not isinstance(wc.get('runtime_bins'),list) or not 1<=len(wc['runtime_bins'])<=4 or not isinstance(wc.get('prefixes'),list) or not 1<=len(wc['prefixes'])<=32:raise SystemExit('Invalid Wine observer configuration')
  for key,flag in [('runtime_bins','--wine-runtime-bin'),('prefixes','--wine-prefix')]:
   for value in wc[key]:
    if not isinstance(value,str) or not pathlib.Path(value).is_absolute():raise SystemExit('Absolute Wine observer paths required')
    args.extend([flag,value])
for kind,flag in [('local','--zone-local'),('internet','--zone-internet')]:
 for prefix in zones[kind]:args.extend([flag,prefix])
environment={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','LANG':'C.UTF-8','NOTIFY_SOCKET':os.environ.get('NOTIFY_SOCKET','')}
# Explicit root service opt-in only. The daemon validates and pins the private
# directory; no other inherited environment reaches the privileged backend.
if os.environ.get('FLOWGATE_PROFILE_DIR'):
 environment['FLOWGATE_PROFILE_DIR']=os.environ['FLOWGATE_PROFILE_DIR']
 if os.environ.get('FLOWGATE_PROFILE_MANUAL') == '1':
  environment['FLOWGATE_PROFILE_MANUAL']='1'
if (here / 'standalone-release.json').is_file():
 args.append('--socket-authorization')
 shape_config = pathlib.Path('/etc/flowgate/shaping.json')
 if shape_config.exists() or shape_config.is_symlink():
  if shape_config.is_symlink() or not shape_config.is_file():
   raise SystemExit('Unsafe shaping configuration')
  st = shape_config.stat()
  if st.st_uid != 0 or st.st_mode & 0o022 or st.st_size > 4096:
   raise SystemExit('Unsafe shaping configuration')
  import re
  interface = json.loads(shape_config.read_text()).get('interface')
  if not isinstance(interface, str) or not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', interface):
   raise SystemExit('Invalid shaping interface')
  args.extend(['--experimental-upload-host-trial','--experimental-upload-interface',interface,'--experimental-upload-helpers',str(here),'--experimental-upload-state','/var/lib/flowgate/upload-experiment'])
os.execve(args[0],args,environment)
