[Unit]
Description=FlowGate application firewall and connection observer
Requires=flowgate-guard.service
Wants=NetworkManager.service bpftune.service
After=flowgate-guard.service NetworkManager.service bpftune.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# Enter through the distro's standard executable label. On Fedora, executing
# directly from /usr/local/lib would leave these programs in SELinux init_t.
ExecStartPre=/usr/bin/env /usr/local/lib/flowgate/current/flowgate monitor-setup
ExecStartPre=/usr/bin/env /usr/local/lib/flowgate/current/flowgate protection-guard --state /run/flowgate-enforcement --desired /var/lib/flowgate/protection.json --bootstrap-database /var/lib/flowgate/rules.db
ExecStart=/usr/bin/env /usr/local/lib/flowgate/current/launch
Restart=on-failure
RestartSec=3s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillMode=control-group
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
