#!/usr/bin/env python3
"""SIMULATION of umu-run's process shape (argv: python3 .../umu-run GAME.exe).
Copied into a private lab run directory; never a real umu/Proton launch.
SIGUSR1 opens one outgoing TCP connection from this launcher process (case a)."""
import os, signal, socket, subprocess, sys, threading
game = os.path.abspath(sys.argv[1])
here = os.path.dirname(os.path.abspath(__file__))
def connect(*_):
    def run():
        try:
            s = socket.create_connection(('10.79.0.2', 43000), timeout=4); s.sendall(b'umu'); s.recv(16); s.close()
        except OSError:
            pass
    threading.Thread(target=run, daemon=True).start()
signal.signal(signal.SIGUSR1, connect)
# srt-bwrap/pv-adverb layer, then proton waitforexitandrun GAME (absolute path).
p = subprocess.Popen(['pv-adverb', os.path.join(here, 'pv-adverb'), '--', sys.executable,
                      os.path.join(os.environ['PROTONPATH'], 'proton'), 'waitforexitandrun', game],
                     executable=sys.executable)
sys.exit(p.wait())
